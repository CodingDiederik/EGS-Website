{
  "name": "website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm --filter egs-backend test",
    "test:e2e": "pnpm --filter egs-backend test:e2e",
    "test:cov": "pnpm --filter egs-backend test:cov",
    "dev:be": "pnpm --filter egs-backend dev",
    "dev:fe": "pnpm --filter egs-frontend dev",
    "dev": "concurrently \"pnpm dev:be\" \"pnpm dev:fe\"",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm -r lint:check",
    "sonar:scan": "pnpm test:cov && pnpm sonar:scannow",
    "sonar:scannow": "dotenv sonar-scanner -Dsonar.projectKey=EGS -Dsonar.sources=src -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.organization=local-org"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@nestjs/cli": "^11.0.10",
    "concurrently": "^9.2.1"
  },
  "type": "module",
  "devDependencies": {
    "@sonar/scan": "^4.3.2",
    "dotenv-cli": "^11.0.0"
  }
}
