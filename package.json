{
  "name": "egs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,md}\"",
    "copy:env": "cp .env.example .env",
    "sonar:scan": "dotenv sonar-scanner -Dsonar.projectKey=egs-frontend -Dsonar.sources=src -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.organization=local-org"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "html-to-text": "^9.0.5",
    "isomorphic-dompurify": "^3.9.0",
    "jsdom": "22.1.0",
    "next": "^16.2.3",
    "postcss": "^8.5.9",
    "prettier": "^3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-photo-album": "^3.6.0",
    "resend": "^6.12.2",
    "yet-another-react-lightbox": "^3.31.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sonar/scan": "^4.3.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "3.0.1",
      "axios": "1.15.0",
      "jsdom": "22.1.0",
      "node-forge": "1.4.0"
    }
  }
}
