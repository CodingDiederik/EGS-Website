{
  "name": "egs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,md}\"",
    "copy:env": "cp .env.example .env",
    "sonar:scan": "dotenv sonar-scanner -Dsonar.projectKey=egs-frontend -Dsonar.sources=src -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.organization=local-org"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "cheerio": "^1.1.2",
    "html-to-text": "^9.0.5",
    "next": "16.0.10",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-placeholder": "^4.1.0",
    "sanitize-html": "^2.17.0",
    "spinners-react": "^1.0.11",
    "yet-another-react-lightbox": "^3.27.0"
  },
  "devDependencies": {
    "@sonar/scan": "^4.3.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.19.26",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
