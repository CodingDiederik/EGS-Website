# JWT Secret Key
JWT_SECRET=your_jwt_secret_key

OVERRIDE_SEEDS=true
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token