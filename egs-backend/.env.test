# Backend port
PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# DB Configuration
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=egs_database
POSTGRES_USER=egs_user
